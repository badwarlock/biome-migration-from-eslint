// Альтернативный формат с комментариями для проверки
{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",

  // VCS интеграция - использует .gitignore
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true  // ✅ Использует .gitignore автоматически
  },

  // Файлы - дополнительные игнорирования сверх .gitignore
  "files": {
    "ignoreUnknown": false,
    "ignore": [
      // ✅ Это свойство существует в Biome!
      // Документация: https://biomejs.dev/reference/configuration/#filesignore
      "coverage/",
      "dist/",
      "public/",
      "__mocks__/",
      "*.d.ts"
      // node_modules/ уже игнорируется через vcs.useIgnoreFile
    ]
  },

  // Остальная конфигурация...
  "formatter": {
    "enabled": true,
    "lineWidth": 100
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
